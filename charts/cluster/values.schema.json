{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enable_prometheus": {
      "type": "string",
      "enum": ["managed", "self", "disabled"]
    },
    "monitoringServiceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" }
      },
      "additionalProperties": false
    },
    "monitoring": {
      "type": "object",
      "properties": {
        "interval": { "type": "string" },
        "managedPrometheus": {
          "type": "object",
          "properties": {
            "secretAccess": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" }
              },
              "required": ["enabled"],
              "additionalProperties": false
            },
            "collectorServiceAccount": { "type": "string" },
            "collectorNamespaces": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            }
          },
          "required": ["secretAccess", "collectorServiceAccount", "collectorNamespaces"],
          "additionalProperties": false
        },
        "rules": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "pd": { "type": "boolean" },
            "tikv": { "type": "boolean" },
            "nodeExporter": { "type": "boolean" },
            "blackbox": { "type": "boolean" },
            "surrealdb": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "surrealdb": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "credentials": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "username": { "type": "string" }
              },
              "required": ["name", "username"],
              "additionalProperties": false
            },
            "secretManager": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "projectId": { "type": "string" },
                "passwordSecret": { "type": "string" },
                "version": { "type": "string" }
              },
              "required": ["enabled", "projectId", "passwordSecret", "version"],
              "additionalProperties": false
            }
          },
          "required": ["enabled", "credentials"],
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}